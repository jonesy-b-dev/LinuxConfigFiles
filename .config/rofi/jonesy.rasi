/**
 * ROFI Color theme
 * User: Jonas
 * Copyright: Jonas de Bruin
 */

* {
    foreground:  rgba(48, 48, 48, 100%);
    backlight:   rgba(255, 238, 221, 80%);
    background-color:  transparent;
    dark: rgba(28, 28, 28, 100%);
    // Black
    black:       rgba(61, 53, 42, 100%);
    lightblack:  rgba(87, 80, 75, 100%);
	darkblack:   rgba(59, 59, 56, 100%);
    tlightblack:  rgba(68, 68, 204, 100%);
    //
    // Red
    red:         rgba(205, 92, 92, 100%);
    lightred:    rgba(204, 85, 51, 100%);
    //
    // Orange
    orange:      rgba(252, 161, 3, 100%);
	darkorange: rgba(182, 119, 20);
    //
    // Green
    green:       rgba(134, 175, 128, 100%);
    lightgreen:  rgba(136, 204, 34, 100%);
    //
    // Yellow
    yellow:      rgba(232, 174, 91, 100%);
    lightyellow:     rgba(255, 167, 93, 100%);
    //
    // Blue
    blue:      rgba(100, 149, 237, 100%);
    lightblue:     rgba(135, 206, 235, 100%);
    //
    // Magenta
    magenta:      rgba(222, 184, 135, 100%);
    lightmagenta:     rgba(153, 102, 0, 100%);
    //
    // Cyan
    cyan:      rgba(176, 196, 222, 100%);
    tcyan:      rgba(176, 196, 222, 80%);
    lightcyan:     rgba(176, 196, 222, 100%);
    //
    // White
    white:      rgba(187, 170, 153, 100%);
    lightwhite:     rgba(221, 204, 187, 100%);
    //
    // Bold, Italic, Underline
    highlight:     underline bold rgba(255, 255, 255, 100%);

    transparent: rgba(0, 0, 0, 0%);
    font: "Hurmit Nerd Font 10";
}

window
{
    location: center;
    anchor:   center;
    transparency: "screenshot";
	padding: 3px;
    border:  0px;
    border-radius: 7px;
    color: @magenta;
    background-color: @orange;
    spacing: 0;
    children:  [mainbox];
    orientation: horizontal;
}

mainbox
{
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message
{
    border-color: @foreground;
    border:  0px 2px 2px 2px;
    //border-radius: 4px;
    padding: 5;
    background-color: @tcyan;
}

message
{
    font: "Source Code Pro 8";
    color: @black;
}

inputbar
{
    color: @foreground;
    padding: 11px;
    background-color: @foreground;
    border: 2px 2px 2px 2px;
    border-radius:  4px 4px 0px 0px;
    border-color: @foreground;
    font: inherit;
}

entry,prompt,case-indicator
{
    text-font: inherit;
    text-color: rgba(197, 200, 198, 100%);
}

prompt
{
    margin:     0px 0.3em 0em 0em ;
}

listview
{
    padding: 8px;
    border-radius: 0px 0px 4px 4px;
    border-color: @foreground;
    border: 0px 2px 2px 2px;
    background-color: @darkblack;
    dynamic: false;
    lines: 10;
}

element
{
    padding: 4px;
    vertical-align: 0.5;
//    border: 2px;
    border-radius: 4px;
    background-color: @lightblack;
    color: @foreground;
    font: inherit;
}

element-text
{
    background-color: inherit;
    text-color: @lightwhite;
}

element selected
{
    text-color: @lightwhite;
}

element selected.normal
{
    background-color: @darkorange;
    text-color: @lightwhite;
}

element selected active
{
    background-color: @lightblue;
    foreground: @black;
}

element selected urgent
{
    background-color: @lightred;
}

element normal active
{
    foreground: @lightblue;
}

element normal urgent
{
    foreground: @lightred;
}

element alternate normal
{
}

element alternate active
{
    foreground: @lightblue;
}

element alternate urgent
{
    foreground: @lightred;
}

element normal normal
{

}

vertb
{
    expand: false;
    children: [ dummy0, mode-switcher, dummy1  ];
}

dummy0,  dummy1
{
    expand: true;
}

mode-switcher
{
    expand: false;
    orientation: vertical;
    spacing: 0px;
    border: 0px 0px 0px 0px;
}

button
{
    font: "FontAwesome 22";
    padding: 6px;
    border: 2px 0px 2px 2px;
    border-radius: 4px 0px 0px 4px;
    background-color: @tlightblack;
    border-color: @orange;
    color: @foreground;
    horizontal-align: 0.5;
}

button selected normal
{
    color: @dark;
    border: 2px 0px 2px 2px;
    background-color: @backlight;
    border-color: @foreground;
}

error-message
{
    expand: true;
    background-color: red;
    border-color: darkred;
    border: 2px;
    padding: 1em;
}
